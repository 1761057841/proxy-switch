#!/bin/bash

### 卸载时清理透明代理，防止残留
### - 关闭代理（删除 iptables 规则 + 恢复 DNS + 停止 mihomo）
### - 移除 systemd 自启服务
### - 注意：保留 /vol1/1000/transparent-proxy 目录（含用户机场节点配置），如需彻底删除请手动执行

cleanup() {
    # 1. 关闭透明代理（幂等）
    if [ -x /vol1/1000/transparent-proxy/tp.sh ]; then
        echo "s1" | sudo -S /vol1/1000/transparent-proxy/tp.sh stop >/dev/null 2>&1 || true
    fi

    # 2. 移除 systemd 自启服务
    if [ -f /etc/systemd/system/transparent-proxy.service ]; then
        echo "s1" | sudo -S systemctl disable transparent-proxy.service >/dev/null 2>&1 || true
        echo "s1" | sudo -S rm -f /etc/systemd/system/transparent-proxy.service >/dev/null 2>&1 || true
        echo "s1" | sudo -S systemctl daemon-reload >/dev/null 2>&1 || true
    fi

    # 3. 兜底清理 iptables 规则
    echo "s1" | sudo -S /usr/sbin/iptables -t nat -D OUTPUT -j TP_OUT >/dev/null 2>&1 || true
    echo "s1" | sudo -S /usr/sbin/iptables -t nat -F TP_OUT >/dev/null 2>&1 || true
    echo "s1" | sudo -S /usr/sbin/iptables -t nat -X TP_OUT >/dev/null 2>&1 || true

    # 4. 恢复 DNS（若指向了本机）
    if grep -q "nameserver 127.0.0.1" /etc/resolv.conf 2>/dev/null; then
        if [ -f /etc/resolv.conf.bak-tproxy ]; then
            echo "s1" | sudo -S cp /etc/resolv.conf.bak-tproxy /etc/resolv.conf >/dev/null 2>&1 || true
        else
            echo "s1" | sudo -S bash -c "echo 'nameserver 192.168.3.1' > /etc/resolv.conf" >/dev/null 2>&1 || true
        fi
    fi
}

cleanup
exit 0
